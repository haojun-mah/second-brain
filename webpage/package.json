{
  "name": "second-brain-dashboard",
  "version": "1.0.0",
  "description": "Read-only web dashboard for a second-brain Obsidian vault (graph, search, rendered Markdown)",
  "type": "commonjs",
  "scripts": {
    "sync": "node sync/sync-vault.mjs",
    "build": "node sync/build.mjs",
    "serve": "python3 server/serve.py",
    "refresh": "npm run sync && npm run build",
    "auth": "python3 sync/make_auth.py"
  },
  "keywords": ["obsidian", "second-brain", "dashboard", "graph"],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "3d-force-graph": "^1.80.0",
    "cytoscape": "^3.34.3",
    "cytoscape-cose-bilkent": "^4.1.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.13",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
