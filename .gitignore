# ---- Secrets & local config -------------------------------------------------
# Never commit credentials. Copy .env.example to .env and fill it in locally.
.env
.env.*
!.env.example
*.pem
*.key
auth.json
shares.json
secrets/

# ---- Node ------------------------------------------------------------------
node_modules/
dist/
.next/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# ---- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
ocrvenv/

# ---- Runtime state & logs --------------------------------------------------
*.log
logs/
*.pid
state/
*_state.json
# Ignore runtime state files everywhere, but KEEP the vault-template copies —
# the template must ship with its seed files intact.
.meta/processed.json
.meta/delta_token.json
.meta/last_lint.json
!vault-template/.meta/processed.json
!vault-template/.meta/.gitkeep
cache/
.sync-cache/
*.db
*.sqlite
*.sqlite3

# ---- Local vault mirrors ---------------------------------------------------
# If you clone/pull your vault locally for grepping, keep it out of git.
vault/
Obsidian/
vault-mirror/
OneDrive/
sync/cache/
webpage/sync/cache/

# ---- Editor / OS -----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
