# =============================================================================
# Second Brain — example environment file
# Copy to .env and fill in.  NEVER commit .env.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Everything below is a placeholder. The setup guide in docs/SETUP.md walks
# through obtaining each value, and docs/CREDENTIALS.md explains the security
# model for each one.
#
# You only fill in ONE backend's block. The other two are ignored.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Which storage backend holds the vault  (required)
# -----------------------------------------------------------------------------
# One of: onedrive | github | local
# Default when unset: onedrive
#
#   onedrive  the vault is a folder in your OneDrive, reached through Microsoft
#             Graph. Needs the MS_* block below.
#   github    the vault is a git repo on GitHub. Needs the GITHUB_* block below.
#             Every write is a commit, so you get full history for free.
#   local     the vault is a directory on this machine. Needs VAULT_LOCAL_PATH.
#             Use this for development, offline use, or if you already sync the
#             folder yourself with Syncthing/Dropbox/iCloud/git.
VAULT_BACKEND=onedrive

# Folder inside the store that holds the vault.
#   onedrive  the folder name at the root of your drive. Default: Obsidian
#   github    the folder inside the repo. Leave as Obsidian, or set to "" to use
#             the repo root itself as the vault.
#   local     only used when the vault is nested inside VAULT_LOCAL_PATH. If you
#             point VAULT_LOCAL_PATH directly at the vault, this is ignored.
VAULT_ROOT=Obsidian


# -----------------------------------------------------------------------------
# 2a. OneDrive backend  (VAULT_BACKEND=onedrive)
# -----------------------------------------------------------------------------
# Application (client) ID of the Azure app registration you create.
# Azure Portal → Microsoft Entra ID → App registrations → your app → Overview.
# Not a secret on its own, but keep it out of public repos anyway.
MS_CLIENT_ID=your_application_client_id_here

# Directory (tenant) ID, or one of the aliases:
#   common        any work, school, or personal account (recommended if unsure)
#   consumers     personal Microsoft accounts only
#   organizations work/school accounts only
MS_TENANT_ID=common

# A long-lived OAuth refresh token for the scope "Files.ReadWrite offline_access".
# Obtain it once with the device-code flow described in docs/SETUP.md, step 2.
# Treat it like a password: it grants read/write access to your entire OneDrive.
MS_REFRESH_TOKEN=your_refresh_token_here


# -----------------------------------------------------------------------------
# 2b. GitHub backend  (VAULT_BACKEND=github)
# -----------------------------------------------------------------------------
# A personal access token with `repo` scope (classic) or Contents: read/write
# (fine-grained, scoped to the one vault repo). Create it at:
#   https://github.com/settings/tokens
# Treat it like a password: it can push to every repo the token can reach.
GITHUB_TOKEN=your_github_token_here

# The repository holding the vault, as "owner/repo". A private repo is fine and
# recommended — the server authenticates with GITHUB_TOKEN.
GITHUB_VAULT_REPO=your-username/your-vault-repo

# Branch to read and commit to. Default: main
GITHUB_VAULT_BRANCH=main


# -----------------------------------------------------------------------------
# 2c. Local backend  (VAULT_BACKEND=local)
# -----------------------------------------------------------------------------
# Absolute path to the directory holding the vault. If VAULT_ROOT is set, the
# vault is expected at "$VAULT_LOCAL_PATH/$VAULT_ROOT"; set VAULT_ROOT= (empty)
# to treat VAULT_LOCAL_PATH itself as the vault.
VAULT_LOCAL_PATH=/absolute/path/to/your/Obsidian


# -----------------------------------------------------------------------------
# 3. Vault location on this machine (helper scripts only)
# -----------------------------------------------------------------------------
# Absolute path where scripts/ look for a local checkout, for the helpers that
# need real bytes on disk (OCR, byte-verified splices). Only needed if the vault
# is reachable locally — leave blank for a pure OneDrive/GitHub setup.
SECOND_BRAIN_VAULT=

# Where helper scripts create their Python virtualenv for OCR.
# Default: $HOME/.second-brain/ocrvenv
SECOND_BRAIN_OCR_VENV=


# -----------------------------------------------------------------------------
# 4. Web dashboard (optional)
# -----------------------------------------------------------------------------
# Password for the read-only web view. Generate a long random string.
BRAIN_PASSWORD=change_me_to_a_long_random_string

# Public base URL used when minting share links, e.g. https://brain.example.com
# Defaults to http://localhost:8741 when unset.
BRAIN_PUBLIC_URL=

# Port the dashboard listens on. Default 8741.
BRAIN_PORT=8741

# Bind address. Default "::" (dual-stack). Use 127.0.0.1 to keep it local-only
# and put a reverse proxy in front of it.
BRAIN_BIND=::

# Which backend the dashboard's sync step pulls from. Defaults to VAULT_BACKEND.
# Only onedrive is implemented in webpage/sync/ today; set this to `local` once
# you have added a local reader (see webpage/README.md).
WEBPAGE_SYNC_BACKEND=


# -----------------------------------------------------------------------------
# 5. Optional integrations
# -----------------------------------------------------------------------------
# Groq API key — only needed for voice-note transcription
# (scripts/audio_transcriber.js). Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Your Telegram numeric user ID, if you drive the orchestrator from Telegram.
# Used to restrict who can talk to the agent. Leave blank to disable.
TELEGRAM_OWNER_ID=


# -----------------------------------------------------------------------------
# 6. Hermes Agent (informational — Hermes reads its own config, not this file)
# -----------------------------------------------------------------------------
# Path to the Hermes home directory if it is not ~/.hermes
# HERMES_HOME=/home/you/.hermes
