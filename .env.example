
# ---- Second Brain (OneDrive) ----
# Azure app client ID (from Azure Portal → App registrations → your app)
MS_CLIENT_ID=

# Azure tenant ID (from Azure Portal → App registrations → your app → Overview)
MS_TENANT_ID=

# OneDrive OAuth refresh token (obtained by running: pnpm exec tsx scripts/setup-onedrive-auth.ts)
# After running the script, this is stored in OneCLI vault automatically.
# Only needed here as a fallback if OneCLI is not configured.
MS_REFRESH_TOKEN=

# ---- Telegram ----
# Telegram bot token (from @BotFather)
# Set this before running /add-telegram skill
TELEGRAM_BOT_TOKEN=
