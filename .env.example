# =============================================================================
# Second Brain — example environment file
# Copy to .env and fill in.  NEVER commit .env.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Everything below is a placeholder. The setup guide in docs/CREDENTIALS.md
# walks through obtaining each value.
# =============================================================================

# -----------------------------------------------------------------------------
# Microsoft Graph (required) — the bridge to your OneDrive-hosted vault
# -----------------------------------------------------------------------------
# Application (client) ID of the Azure app registration you create.
# Azure Portal → Microsoft Entra ID → App registrations → your app → Overview.
MS_CLIENT_ID=your_application_client_id_here

# Directory (tenant) ID, or the literal string "common" for personal accounts
# and multi-tenant apps. "consumers" also works for personal Microsoft accounts.
MS_TENANT_ID=common

# A long-lived OAuth refresh token for the scope "Files.ReadWrite offline_access".
# Obtain it once with the device-code flow described in docs/CREDENTIALS.md.
# Treat it like a password: it grants read/write access to your OneDrive files.
MS_REFRESH_TOKEN=your_refresh_token_here

# Optional: override the folder inside your OneDrive that holds the vault.
# The MCP server addresses "/me/drive/root:/<VAULT_ROOT>/...". Change this only
# if your Obsidian folder is not named "Obsidian" at the root of your drive.
MS_VAULT_ROOT=Obsidian

# -----------------------------------------------------------------------------
# Vault location on this machine (only needed for local helper scripts)
# -----------------------------------------------------------------------------
# Absolute path where scripts/ and the webpage sync look for a local checkout.
# Leave blank if you only use the OneDrive-hosted copy through the MCP server.
SECOND_BRAIN_VAULT=

# Where helper scripts create their Python virtualenv for OCR.
# Default: $HOME/.second-brain/ocrvenv
SECOND_BRAIN_OCR_VENV=

# -----------------------------------------------------------------------------
# Web dashboard (optional)
# -----------------------------------------------------------------------------
# Password for the read-only web view. Generate a long random string.
BRAIN_PASSWORD=change_me_to_a_long_random_string

# Public base URL used when minting share links, e.g. https://brain.example.com
# Defaults to http://localhost:8741 when unset.
BRAIN_PUBLIC_URL=

# Port the dashboard listens on. Default 8741.
BRAIN_PORT=8741

# Bind address. Default "::" (dual-stack). Use 127.0.0.1 to keep it local-only
# and put a reverse proxy in front of it.
BRAIN_BIND=::

# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------
# Groq API key — only needed for voice-note transcription
# (scripts/audio_transcriber.js). Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Your Telegram numeric user ID, if you drive the orchestrator from Telegram.
# Used to restrict who can talk to the agent. Leave blank to disable.
TELEGRAM_OWNER_ID=

# -----------------------------------------------------------------------------
# Hermes Agent (informational — Hermes reads its own config, not this file)
# -----------------------------------------------------------------------------
# Path to the Hermes home directory if it is not ~/.hermes
# HERMES_HOME=/home/you/.hermes
