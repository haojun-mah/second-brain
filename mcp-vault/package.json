{
  "name": "vault-mcp-server",
  "version": "2.0.0",
  "description": "MCP server exposing a Markdown vault as tools, over a pluggable storage backend (OneDrive, GitHub, or a local folder)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "vault-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.3"
  },
  "license": "MIT"
}
